{% include 'shared/_env_header.csh.j2' %}
{## =========================================================================== ##}
{## Stage: IXCOM Multi-Step Stage 3 — Hardware Compile (-target xecompile)      ##}
{## Reference: compileIXCOM.pdf P210/P214/P306, emulator.pdf P15-P16, WXE 24.05 ##}
{## =========================================================================== ##}
mkdir -p ./WORK
if ( $status != 0 ) exit $status

{% if et3confg %}
unsetenv XE_HOST
setenv XE_HOST_FILE '{{ et3confg }}'
{% elif emu_host %}
setenv XE_HOST '{{ emu_host }}'
{% endif %}
{% if boards %}
setenv XE_BOARDS '{{ boards }}'
{% endif %}

{{ cmd | default('ixcom') }} -target {{ xecompile_target | default('xecompile') }} \
{% if use_custom_impt_qel %}
  -xeCompile import=import.qel \
{% endif %}
{% if use_custom_comp_qel %}
  -xeCompile compile=compile.qel \
{% endif %}
{% if xecompile_opts %}
  -xecompileargs "{{ xecompile_opts | join(' ') }}" \
{% endif %}
{% for opt in opts %}
  {{ opt }} \
{% endfor %}
  -l ixcom_xecompile.log
set rc = $status
if ( $rc != 0 ) exit $rc
