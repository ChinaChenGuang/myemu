{% include 'shared/_env_header.csh.j2' %}
{## =========================================================================== ##}
{## Stage: IXCOM Multi-Step Stage 2 — HDL-ICE Synthesis (-target hdlice)        ##}
{## Reference: compileIXCOM.pdf P39-P40/P213, WXE 24.05                         ##}
{## =========================================================================== ##}
mkdir -p ./WORK
if ( $status != 0 ) exit $status

{{ cmd | default('ixcom') }} \
  -target hdlice \
  +sv -ua -libmaprc {{ libmaprc | default('libmaprc') }} \
  +dut+{{ design_top }}{% if clk_module %}+{{ clk_module }}{% endif %} \
{% if parallel_hdlice %}
  -parallelHdliceAnalyze {{ parallel_hdlice }} \
{% endif %}
{% for opt in opts %}
  {{ opt }} \
{% endfor %}
  -l ixcom_hdlice.log
set rc = $status
if ( $rc != 0 ) exit $rc
