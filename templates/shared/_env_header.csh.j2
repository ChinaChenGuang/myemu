{% if emu_root %}
setenv EMU_ROOT '{{ emu_root }}'
{% endif %}
{% if 'XE_HOST_FILE' in env_vars %}
unsetenv XE_HOST
{% endif %}
{% for key, val in env_vars.items() %}
{% if key != 'EMU_ROOT' %}
setenv {{ key }} '{{ val }}'
{% endif %}
{% endfor %}
{% for script in setup_scripts %}
source "{{ script }}"
{% endfor %}
{% if workdir %}
cd "{{ workdir }}"
if ( $status != 0 ) exit $status
{% endif %}
