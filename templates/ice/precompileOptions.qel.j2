# Auto-generated Palladium ICE precompile options for {{ db_name }}

{% for opt in precompile_options %}
{% if ' ' in opt and not (opt.startswith('{') and opt.endswith('}')) %}
precompileOption -add {{ '{' }}{{ opt }}{{ '}' }}
{% else %}
precompileOption -add {{ opt }}
{% endif %}
{% endfor %}
